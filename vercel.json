{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/(api|auth)(/.*)?",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!(api|auth)(/|$)|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
