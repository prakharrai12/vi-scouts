{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/server.py"
    },
    {
      "source": "/((?!api/|auth/|assets/|.*\\.(?:png|svg|ico|json|jpg|webp|css|js)$).*)",
      "destination": "/index.html"
    }
  ]
}
